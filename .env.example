# --- Database ---
POSTGRES_USER=mm
POSTGRES_PASSWORD=mm_local_dev
POSTGRES_DB=moneymanagement
DATABASE_URL=postgresql+psycopg://mm:mm_local_dev@postgres:5432/moneymanagement

# --- Backend ---
APP_ENV=local
APP_PORT=8000
APP_SECRET=change-me-to-a-long-random-string
SINGLE_USER_PASSWORD=change-me

# --- KIS Open API (한국투자증권) ---
# Fill after applying at https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_PAPER_MODE=true

# --- Slack (optional, can leave empty if using Telegram only) ---
SLACK_WEBHOOK_URL=

# --- Telegram bot (optional, can leave empty if using Slack only) ---
# 1. Talk to @BotFather → /newbot → get TOKEN
# 2. Send any message to your bot to start the chat
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates → find "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
